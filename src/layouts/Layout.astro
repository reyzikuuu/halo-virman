---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Virman Adipura | Editor Video & Junior Meta Ads",
	description = "Portofolio pribadi Virman Adipura. Editor video, kreator konten, dan digital enthusiast dari Tasikmalaya.",
	image = "/og-images.jpeg"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url);
const imageUrl = new URL(image, Astro.site || Astro.url);
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		<link rel="icon" href="/favicon/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={imageUrl} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Virman Adipura",
			"url": canonicalURL.toString(),
			"image": imageUrl.toString(),
			"jobTitle": "Junior Video Editor & Meta Advertiser",
			"worksFor": {
				"@type": "Organization",
				"name": "Freelance"
			},
			"sameAs": [
				"https://www.instagram.com/virmanadipuraaa_/"
			]
		})} />

		<!-- Preconnect for faster Google Analytics & GTM loading -->
		<link rel="preconnect" href="https://www.googletagmanager.com" />
		<link rel="preconnect" href="https://www.google-analytics.com" />

		<!-- Google Analytics 4 (gtag.js) -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GP5VM5QTWS"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-GP5VM5QTWS', {
				// Accurate page view tracking (works with Astro view transitions)
				send_page_view: true,
				// Privacy-conscious defaults
				anonymize_ip: true,
				// Secure cookie settings for accurate cross-session tracking
				cookie_flags: 'SameSite=None;Secure',
				cookie_domain: 'halovirman.my.id',
				// Enhanced link attribution for accurate click tracking
				link_attribution: true
			});
		</script>
		<!-- End Google Analytics 4 -->

		<!-- Google Tag Manager -->
		<script is:inline>
			(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-PNZZSCTH');
		</script>
		<!-- End Google Tag Manager -->

		<!-- First-Party Analytics (Anti Ad-Block Meta Pixel) -->
		<script is:inline src="/js/fp-analytics.js" defer data-type="analytics"></script>
		<noscript>
			<img height="1" width="1" style="display:none"
				src="https://www.facebook.com/tr?id=1055596653921923&ev=PageView&noscript=1" />
		</noscript>
		<!-- End First-Party Analytics -->
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript>
			<iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PNZZSCTH"
				height="0" width="0" style="display:none;visibility:hidden"></iframe>
		</noscript>
		<!-- End Google Tag Manager (noscript) -->

		<Navbar />
		<slot />
	</body>
</html>

<script>
	const observerOptions = {
		root: null,
		rootMargin: '0px',
		threshold: 0.15
	};

	const observer = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
				observer.unobserve(entry.target);
			}
		});
	}, observerOptions);

	// Tunggu sampai DOM siap
	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('.reveal').forEach(el => {
			observer.observe(el);
		});
	});
</script>

<!-- GA4 Event Tracking: CTA clicks & scroll depth -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// Helper: safely call gtag
		function trackEvent(eventName, params) {
			if (typeof gtag === 'function') {
				gtag('event', eventName, params);
			}
		}

		// ===== CTA Button Click Tracking =====
		// Portfolio button
		document.querySelectorAll('.btn-primary').forEach(function(btn) {
			btn.addEventListener('click', function() {
				trackEvent('cta_click', {
					event_category: 'engagement',
					event_label: 'portfolio',
					link_url: btn.getAttribute('href'),
					link_text: btn.textContent.trim()
				});
			});
		});

		// WhatsApp button
		document.querySelectorAll('.btn-whatsapp').forEach(function(btn) {
			btn.addEventListener('click', function() {
				trackEvent('cta_click', {
					event_category: 'conversion',
					event_label: 'whatsapp_contact',
					link_url: btn.getAttribute('href'),
					link_text: btn.textContent.trim()
				});
				// Also fire as a conversion event for Google Ads
				trackEvent('conversion', {
					send_to: 'G-GP5VM5QTWS',
					event_category: 'lead',
					event_label: 'whatsapp_click'
				});
			});
		});

		// Social link clicks
		document.querySelectorAll('.social-icon').forEach(function(link) {
			link.addEventListener('click', function() {
				trackEvent('social_click', {
					event_category: 'engagement',
					event_label: link.getAttribute('title') || 'social',
					link_url: link.getAttribute('href')
				});
			});
		});

		// ===== Scroll Depth Tracking =====
		var scrollMilestones = { 25: false, 50: false, 75: false, 100: false };
		var ticking = false;

		window.addEventListener('scroll', function() {
			if (!ticking) {
				window.requestAnimationFrame(function() {
					var scrollPercent = Math.round(
						(window.scrollY / (document.documentElement.scrollHeight - window.innerHeight)) * 100
					);
					[25, 50, 75, 100].forEach(function(milestone) {
						if (scrollPercent >= milestone && !scrollMilestones[milestone]) {
							scrollMilestones[milestone] = true;
							trackEvent('scroll_depth', {
								event_category: 'engagement',
								event_label: milestone + '%',
								value: milestone
							});
						}
					});
					ticking = false;
				});
				ticking = true;
			}
		}, { passive: true });
	});
</script>

<style is:global>
	.reveal {
		opacity: 0;
		transform: translateY(30px);
		transition: all 0.8s cubic-bezier(0.5, 0, 0, 1);
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}
</style>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
