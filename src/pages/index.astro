---
import Layout from "../layouts/Layout.astro";
import Lanyard from "../components/Lanyard.jsx";
import AuroraBackground from "../components/AuroraBackground.astro";
---

<Layout
	title="Rey | Web Developer Portfolio"
	description="Portofolio pribadi Rey. Menampilkan karya dan eksperimen web interaktif."
>
	<main
		class="relative w-full min-h-screen bg-black overflow-hidden font-sans"
	>
		<AuroraBackground />

		<!-- Hero Section: Two-Column Layout -->
		<div class="hero-container">
			<!-- LEFT: Hero Text Content -->
			<div class="hero-left">
				<!-- Status Badge -->
				<div class="status-badge">
					<span class="status-dot"></span>
					<span>Available for projects</span>
				</div>

				<!-- Main Heading -->
				<h1 class="hero-title">
					<span class="hero-greeting">Halo, saya</span>
					<span class="hero-name"
						>Virman Adipura<span class="accent-dot">.</span></span
					>
				</h1>

				<!-- Subtitle / Role (Typewriter) -->
				<div class="hero-role" id="hero-role">
					<span class="role-icon" id="role-icon">
						<!-- Video icon (default) -->
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><polygon points="23 7 16 12 23 17 23 7"
							></polygon><rect
								x="1"
								y="5"
								width="15"
								height="14"
								rx="2"
								ry="2"></rect></svg
						>
					</span>
					<span class="role-text" id="role-text"></span>
					<span class="typewriter-cursor">|</span>
				</div>

				<!-- Description -->
				<p class="hero-description">
					Mengubah ide menjadi pengalaman digital yang interaktif.
					Berfokus pada desain modern, animasi halus, dan teknologi
					web terkini.
				</p>

				<!-- Tools Icons -->
				<div class="tech-stack">
					<span class="tech-label">software</span>
					<div class="tech-icons">
						<!-- CapCut -->
						<div class="tech-icon" title="CapCut">
							<img
								src="/icon-tech-stack/capcut-icon.webp"
								alt="CapCut"
								width="22"
								height="22"
								class="tool-image-icon"
							/>
						</div>
						<!-- Photoshop -->
						<div class="tech-icon" title="Photoshop">
							<img
								src="/icon-tech-stack/photoshop-icon.png"
								alt="Photoshop"
								width="22"
								height="22"
								class="tool-image-icon"
							/>
						</div>
						<!-- Premiere Pro -->
						<div class="tech-icon" title="Premiere Pro">
							<img
								src="/icon-tech-stack/priemere-pro-icon.png"
								alt="Premiere Pro"
								width="22"
								height="22"
								class="tool-image-icon"
							/>
						</div>
						<!-- After Effects -->
						<div class="tech-icon" title="After Effects">
							<img
								src="/icon-tech-stack/after-effect-icon.png"
								alt="After Effects"
								width="22"
								height="22"
								class="tool-image-icon"
							/>
						</div>
						<!-- Meta -->
						<div class="tech-icon" title="Meta">
							<img
								src="/icon-tech-stack/meta-icon.webp"
								alt="Meta"
								width="22"
								height="22"
								class="tool-image-icon"
							/>
						</div>
					</div>
				</div>

				<!-- CTA Buttons -->
				<div class="hero-cta">
					<a href="#karya" class="btn-primary">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="3"
								width="20"
								height="14"
								rx="2"
								ry="2"></rect><line
								x1="8"
								y1="21"
								x2="16"
								y2="21"></line><line
								x1="12"
								y1="17"
								x2="12"
								y2="21"></line></svg
						>
						Lihat Karya Saya
					</a>
					<a href="#kontak" class="btn-secondary">
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
							></path><polyline points="22,6 12,13 2,6"
							></polyline></svg
						>
						Hubungi Saya
					</a>
				</div>

				<!-- Social Links -->
				<div class="social-links">
					<a
						href="https://github.com/reyzikuuu"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon"
						title="GitHub"
						aria-label="GitHub Profile"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
							></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
						>
					</a>
					<a
						href="https://instagram.com/reyzikuuu"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon"
						title="Instagram"
						aria-label="Instagram Profile"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="2"
								width="20"
								height="20"
								rx="5"
								ry="5"></rect><path
								d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
							></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
							></line></svg
						>
					</a>
					<a
						href="https://linkedin.com/in/reyzikuuu"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon"
						title="LinkedIn"
						aria-label="LinkedIn Profile"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path
								d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
							></path><rect x="2" y="9" width="4" height="12"
							></rect><circle cx="4" cy="4" r="2"></circle></svg
						>
					</a>
				</div>
			</div>

			<!-- RIGHT: Lanyard 3D -->
			<div class="hero-right">
				<Lanyard
					client:only="react"
					position={[0, 0, 20]}
					gravity={[0, -40, 0]}
					transparent={true}
				/>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div class="scroll-indicator">
			<div class="scroll-mouse">
				<div class="scroll-wheel"></div>
			</div>
			<span class="scroll-text">Scroll ke bawah</span>
		</div>
	</main>
</Layout>

<style>
	/* ===== HERO CONTAINER: Two-Column Layout ===== */
	.hero-container {
		position: absolute;
		inset: 0;
		z-index: 20;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-end;
		padding: 0 1.5rem 4rem;
		min-height: 100vh;
		pointer-events: none;
	}

	@media (min-width: 1024px) {
		.hero-container {
			flex-direction: row;
			align-items: center;
			justify-content: center;
			gap: 2rem;
			padding: 6rem 4rem 0;
			max-width: 1400px;
			margin: 0 auto;
			left: 50%;
			transform: translateX(-50%);
		}
	}

	/* ===== LEFT COLUMN: Hero Text ===== */
	.hero-left {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 1rem;
		z-index: 10;
		max-width: 600px;
		pointer-events: none;
	}

	@media (min-width: 1024px) {
		.hero-container {
			pointer-events: auto;
		}
		.hero-left {
			flex: 1;
			align-items: flex-start;
			text-align: left;
			max-width: 560px;
			pointer-events: auto;
		}
	}

	/* ===== RIGHT COLUMN: Lanyard ===== */
	.hero-right {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100vh;
		cursor: grab;
		z-index: 1;
		touch-action: none;
		pointer-events: auto;
	}

	.hero-right:active {
		cursor: grabbing;
	}

	@media (min-width: 1024px) {
		.hero-right {
			position: relative;
			inset: auto;
			flex: 1;
			height: 100vh;
			max-width: 50%;
		}
	}

	/* ===== STATUS BADGE ===== */
	.status-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 1rem;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 9999px;
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.7);
		letter-spacing: 0.02em;
		backdrop-filter: blur(8px);
		animation: fadeInUp 0.6s ease-out both;
	}

	.status-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #34d399;
		box-shadow:
			0 0 8px #34d399,
			0 0 16px rgba(52, 211, 153, 0.3);
		animation: pulse-dot 2s ease-in-out infinite;
	}

	/* ===== HERO TITLE ===== */
	.hero-title {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		animation: fadeInUp 0.6s ease-out 0.1s both;
	}

	.hero-greeting {
		font-size: 1.2rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.5);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.hero-name {
		font-size: clamp(3rem, 7vw, 5rem);
		font-weight: 800;
		color: white;
		letter-spacing: -0.04em;
		line-height: 1;
	}

	.accent-dot {
		color: #818cf8;
	}

	/* ===== HERO ROLE ===== */
	.hero-role {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.1rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.8);
		animation: fadeInUp 0.6s ease-out 0.2s both;
	}

	.role-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #818cf8;
		transition: opacity 0.3s ease;
	}

	.role-text {
		display: inline-block;
		min-width: 0;
	}

	.typewriter-cursor {
		display: inline-block;
		color: #818cf8;
		font-weight: 300;
		animation: blink 1s step-end infinite;
		margin-left: 1px;
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	/* ===== HERO DESCRIPTION ===== */
	.hero-description {
		font-size: 1rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.45);
		max-width: 440px;
		animation: fadeInUp 0.6s ease-out 0.3s both;
	}

	/* ===== TECH STACK ===== */
	.tech-stack {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		animation: fadeInUp 0.6s ease-out 0.4s both;
	}

	.tech-label {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.3);
		font-weight: 600;
	}

	.tech-icons {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		pointer-events: auto;
	}

	.tech-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.5);
		transition: all 0.3s ease;
		cursor: default;
	}

	.tech-icon:hover {
		background: rgba(129, 140, 248, 0.15);
		border-color: rgba(129, 140, 248, 0.3);
		color: #818cf8;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(129, 140, 248, 0.15);
	}

	.tool-image-icon {
		width: 22px;
		height: 22px;
		object-fit: contain;
		opacity: 0.7;
		transition: all 0.3s ease;
		/* Opsional: filter: grayscale(100%); if user wants them monochrome */
	}

	.tech-icon:hover .tool-image-icon {
		opacity: 1;
		transform: scale(1.1);
	}

	/* ===== CTA BUTTONS ===== */
	.hero-cta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		animation: fadeInUp 0.6s ease-out 0.5s both;
		pointer-events: auto;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: white;
		color: black;
		font-weight: 600;
		font-size: 0.9rem;
		border-radius: 9999px;
		text-decoration: none;
		transition: all 0.3s ease;
		box-shadow: 0 0 20px rgba(255, 255, 255, 0.15);
	}

	.btn-primary:hover {
		background: #e4e4e7;
		transform: scale(1.04);
		box-shadow: 0 0 30px rgba(255, 255, 255, 0.25);
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: transparent;
		color: rgba(255, 255, 255, 0.8);
		font-weight: 500;
		font-size: 0.9rem;
		border-radius: 9999px;
		border: 1px solid rgba(255, 255, 255, 0.15);
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.btn-secondary:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.3);
		color: white;
	}

	/* ===== SOCIAL LINKS ===== */
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-top: 0.5rem;
		animation: fadeInUp 0.6s ease-out 0.6s both;
		pointer-events: auto;
	}

	.social-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border-radius: 50%;
		color: rgba(255, 255, 255, 0.4);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		text-decoration: none;
		transition: all 0.3s ease;
	}

	.social-icon:hover {
		color: white;
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
	}

	/* ===== SCROLL INDICATOR ===== */
	.scroll-indicator {
		position: absolute;
		bottom: 2rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 30;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		animation: fadeInUp 0.6s ease-out 1s both;
	}

	.scroll-mouse {
		width: 24px;
		height: 38px;
		border: 2px solid rgba(255, 255, 255, 0.2);
		border-radius: 12px;
		display: flex;
		justify-content: center;
		padding-top: 6px;
	}

	.scroll-wheel {
		width: 3px;
		height: 8px;
		background: rgba(255, 255, 255, 0.5);
		border-radius: 2px;
		animation: scroll-bounce 2s ease-in-out infinite;
	}

	.scroll-text {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.25);
	}

	/* ===== ANIMATIONS ===== */
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes pulse-dot {
		0%,
		100% {
			opacity: 1;
			box-shadow:
				0 0 8px #34d399,
				0 0 16px rgba(52, 211, 153, 0.3);
		}
		50% {
			opacity: 0.6;
			box-shadow:
				0 0 4px #34d399,
				0 0 8px rgba(52, 211, 153, 0.15);
		}
	}

	@keyframes scroll-bounce {
		0%,
		100% {
			transform: translateY(0);
			opacity: 1;
		}
		50% {
			transform: translateY(6px);
			opacity: 0.3;
		}
	}

	/* ===== MOBILE ADJUSTMENTS ===== */
	@media (max-width: 1023px) {
		.hero-name {
			font-size: clamp(2.2rem, 9vw, 3.2rem);
		}

		.hero-greeting {
			font-size: 1rem;
		}

		.hero-role {
			font-size: 0.95rem;
		}

		.hero-description {
			font-size: 0.85rem;
			line-height: 1.5;
		}

		.tech-label {
			font-size: 0.65rem;
		}

		.tech-icon {
			width: 34px;
			height: 34px;
		}

		.tech-icon svg {
			width: 18px;
			height: 18px;
		}

		.btn-primary,
		.btn-secondary {
			padding: 0.6rem 1.2rem;
			font-size: 0.85rem;
		}

		.social-icon {
			width: 34px;
			height: 34px;
		}

		.social-icon svg {
			width: 17px;
			height: 17px;
		}

		.scroll-indicator {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.hero-cta {
			flex-direction: column;
			width: 100%;
		}

		.btn-primary,
		.btn-secondary {
			width: 100%;
			justify-content: center;
		}
	}
</style>

<script>
	(function () {
		const roles = [
			{
				text: "Video Editor & Layout Designer",
				icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>',
			},
			{
				text: "Junior Meta Advertiser",
				icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.2 8.4c.5.38.8.97.8 1.6v4a2 2 0 0 1-1 1.73l-7 4a2 2 0 0 1-2 0l-7-4A2 2 0 0 1 4 14v-4c0-.63.3-1.22.8-1.6l7-5a2 2 0 0 1 2.4 0l7 5Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>',
			},
		];

		const roleText = document.getElementById("role-text");
		const roleIcon = document.getElementById("role-icon");
		if (!roleText || !roleIcon) return;

		let currentRole = 0;
		let charIndex = 0;
		let isDeleting = false;
		const typingSpeed = 65;
		const deletingSpeed = 35;
		const pauseAfterType = 2500;
		const pauseAfterDelete = 400;

		function typeRole() {
			if (!roleText || !roleIcon) return;
			const current = roles[currentRole];

			if (!isDeleting) {
				roleText.textContent = current.text.substring(0, charIndex + 1);
				charIndex++;

				if (charIndex === current.text.length) {
					setTimeout(() => {
						isDeleting = true;
						typeRole();
					}, pauseAfterType);
					return;
				}
				setTimeout(typeRole, typingSpeed);
			} else {
				roleText.textContent = current.text.substring(0, charIndex - 1);
				charIndex--;

				if (charIndex === 0) {
					isDeleting = false;
					currentRole = (currentRole + 1) % roles.length;
					roleIcon.innerHTML = roles[currentRole].icon;
					setTimeout(typeRole, pauseAfterDelete);
					return;
				}
				setTimeout(typeRole, deletingSpeed);
			}
		}

		// Start immediately — Astro module scripts are deferred, DOM is ready
		roleIcon.innerHTML = roles[0].icon;
		setTimeout(typeRole, 800);
	})();
</script>
