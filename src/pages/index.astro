---
import { getImage } from "astro:assets";
import mobileHeroImg from "../assets/images/lanyard-hero-mobile.webp";
import Layout from "../layouts/Layout.astro";
import AuroraBackground from "../components/AuroraBackground.astro";
import HeroSection from "../components/HeroSection.astro";
import VideoMarquee from "../components/VideoMarquee.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import InfoModal from "../components/InfoModal.astro";
import Footer from "../components/Footer.astro";

// Pre-optimize the mobile hero image so preload link and img tag share the exact matching URL & responsive dimensions
const mobileHeroOptimized = await getImage({
	src: mobileHeroImg,
	format: "webp",
	width: 480,
});
---

<Layout
	title="Virman Adipura | Junior Video Editor & Meta Advertiser"
	description="Official Website Portofolio CV Virman Adipura. Junior editor video, junior meta advertiser & digital enthusiast dari Tasikmalaya."
	preloadHeroSrc={mobileHeroOptimized.src}
>
	<main class="relative w-full min-h-screen bg-black overflow-hidden font-sans">
		<div class="relative w-full h-screen">
			<AuroraBackground />
			<HeroSection heroImg={mobileHeroOptimized} />
			<ScrollIndicator />
		</div>
		<VideoMarquee />
		<InfoModal />
	</main>
	<Footer />
</Layout>
