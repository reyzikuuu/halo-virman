---
// AuroraBackground.astro
---

<div class="aurora-root">
  <!-- Base gradient -->
  <div class="aurora-base"></div>

  <!-- Floating orbs (CSS, GPU-accelerated) -->
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>

  <!-- Mesh overlay -->
  <div class="aurora-mesh"></div>

  <!-- RAYS: separate canvas with CSS blur (GPU-accelerated, not ctx.filter) -->
  <canvas class="aurora-rays-canvas" id="aurora-rays"></canvas>

  <!-- PARTICLES: lightweight canvas, no filters -->
  <canvas class="aurora-particles-canvas" id="aurora-particles"></canvas>

  <!-- Dot grid -->
  <div class="aurora-dots"></div>

  <!-- Grain -->
  <div class="aurora-grain"></div>

  <!-- CSS light source glow -->
  <div class="light-source"></div>
</div>

<style>
  .aurora-root {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* === BASE GRADIENT === */
  .aurora-base {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 100% 60% at 50% -5%,
      #1a0a3a 0%, #0b0618 35%, #050310 60%, #02020a 100%
    );
  }

  /* === LIGHT SOURCE GLOW === */
  .light-source {
    position: absolute;
    top: -10vh;
    left: 50%;
    transform: translateX(-50%);
    width: 38vw;
    height: 38vw;
    background: radial-gradient(
      circle,
      rgba(150, 90, 255, 0.45) 0%,
      rgba(100, 50, 210, 0.18) 40%,
      transparent 70%
    );
    border-radius: 50%;
    filter: blur(18px);
    animation: source-pulse 6s ease-in-out infinite alternate;
    /* GPU hint */
    will-change: transform, opacity;
  }

  @keyframes source-pulse {
    0%   { opacity: 0.7; transform: translateX(-50%) scale(1); }
    100% { opacity: 1;   transform: translateX(-50%) scale(1.14); }
  }

  /* === ORBS (GPU via blur + will-change) === */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    mix-blend-mode: screen;
    will-change: transform;
  }
  .orb-1 {
    width: 60vw; height: 40vw;
    top: -20%; left: -5%;
    background: radial-gradient(circle, rgba(110, 50, 220, 0.22) 0%, transparent 70%);
    animation: orb-drift-1 20s ease-in-out infinite alternate;
  }
  .orb-2 {
    width: 50vw; height: 50vw;
    top: -10%; right: -10%;
    background: radial-gradient(circle, rgba(70, 20, 160, 0.18) 0%, transparent 70%);
    animation: orb-drift-2 25s ease-in-out infinite alternate;
  }
  .orb-3 {
    width: 40vw; height: 40vw;
    bottom: 0%; left: 25%;
    background: radial-gradient(circle, rgba(40, 10, 100, 0.20) 0%, transparent 70%);
    animation: orb-drift-3 18s ease-in-out infinite alternate;
  }
  @keyframes orb-drift-1 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(3vw, 5vh) scale(1.06); }
  }
  @keyframes orb-drift-2 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(-4vw, 3vh) scale(0.96); }
  }
  @keyframes orb-drift-3 {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(5vw, -4vh) scale(1.04); }
  }

  /* === MESH === */
  .aurora-mesh {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 70% 30% at 50% 0%, rgba(120, 60, 255, 0.12) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 10% 70%, rgba(80, 30, 180, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 90% 80%, rgba(60, 10, 140, 0.07) 0%, transparent 60%);
  }

  /* === RAYS CANVAS: CSS blur = GPU accelerated === */
  .aurora-rays-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* CSS filter is compositor-thread (GPU), NOT software per-pixel */
    filter: blur(12px);
    opacity: 0.7;
    will-change: opacity;
  }

  /* === PARTICLES CANVAS: no filter === */
  .aurora-particles-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }

  /* === DOT GRID === */
  .aurora-dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.055) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, #000 20%, transparent 100%);
  }

  /* === GRAIN === */
  .aurora-grain {
    position: absolute;
    inset: -50%; width: 200%; height: 200%;
    opacity: 0.03;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    animation: grain-move 8s steps(10) infinite;
  }
  @keyframes grain-move {
    0%  { transform: translate(0,0); }    10% { transform: translate(-2%,-3%); }
    20% { transform: translate(3%,2%); }  30% { transform: translate(-1%,4%); }
    40% { transform: translate(4%,-1%); } 50% { transform: translate(-3%,3%); }
    60% { transform: translate(2%,-4%); } 70% { transform: translate(-4%,1%); }
    80% { transform: translate(1%,-2%); } 90% { transform: translate(-2%,4%); }
    100%{ transform: translate(0,0); }
  }
</style>

<script>
  (function () {
    // ── Helpers ────────────────────────────────────────────────────────────
    function getCtx(id: string): CanvasRenderingContext2D | null {
      const el = document.getElementById(id) as HTMLCanvasElement | null;
      if (!el) return null;
      return el.getContext('2d');
    }

    let W = window.innerWidth;
    let H = window.innerHeight;

    // Size both canvases
    function resizeCanvases() {
      W = window.innerWidth;
      H = window.innerHeight;
      const rays = document.getElementById('aurora-rays') as HTMLCanvasElement;
      const particles = document.getElementById('aurora-particles') as HTMLCanvasElement;
      if (rays) { rays.width = W; rays.height = H; }
      if (particles) { particles.width = W; particles.height = H; }
    }

    window.addEventListener('resize', () => {
      resizeCanvases();
      buildRays();
    });

    resizeCanvases();

    // ── RAYS (drawn on their own canvas, blurred via CSS) ──────────────────
    const raysCtx = getCtx('aurora-rays');

    interface Ray {
      angle: number;
      halfSpread: number;
      length: number;
      alpha: number;
      targetAlpha: number;
      speed: number;
      color: string;
    }

    const rays: Ray[] = [];

    function buildRays() {
      rays.length = 0;
      const CONFIGS = [
        { angle: -0.40, spread: 0.09, len: 1.40 },
        { angle: -0.10, spread: 0.11, len: 1.50 },
        { angle:  0.12, spread: 0.10, len: 1.45 },
        { angle:  0.42, spread: 0.08, len: 1.35 },
      ];
      const COLORS = [
        'rgba(190,130,255,',
        'rgba(160,100,245,',
        'rgba(210,160,255,',
        'rgba(170,110,250,',
      ];
      const diag = Math.sqrt(W * W + H * H);
      for (let i = 0; i < CONFIGS.length; i++) {
        const c = CONFIGS[i];
        rays.push({
          angle: c.angle,
          halfSpread: c.spread,
          length: diag * c.len,
          alpha: Math.random() * 0.12,
          targetAlpha: Math.random() * 0.28 + 0.06,
          speed: 0.003 + Math.random() * 0.004,
          color: COLORS[i],
        });
      }
    }

    function drawRays() {
      if (!raysCtx) return;
      raysCtx.clearRect(0, 0, W, H);

      const sx = W / 2;
      const sy = -H * 0.04;

      for (const ray of rays) {
        // Lerp alpha
        ray.alpha += (ray.targetAlpha - ray.alpha) * ray.speed;
        if (Math.abs(ray.alpha - ray.targetAlpha) < 0.001) {
          ray.targetAlpha = Math.random() * 0.28 + 0.04;
          ray.speed = 0.002 + Math.random() * 0.004;
        }

        const la = ray.angle - ray.halfSpread;
        const ra = ray.angle + ray.halfSpread;
        const lx = sx + Math.sin(la) * ray.length;
        const ly = sy + Math.cos(la) * ray.length;
        const rx = sx + Math.sin(ra) * ray.length;
        const ry = sy + Math.cos(ra) * ray.length;
        const mx = (lx + rx) / 2;
        const my = (ly + ry) / 2;

        const grad = raysCtx.createLinearGradient(sx, sy, mx, my);
        grad.addColorStop(0,    `${ray.color}${ray.alpha})`);
        grad.addColorStop(0.45, `${ray.color}${ray.alpha * 0.35})`);
        grad.addColorStop(1,    `${ray.color}0)`);

        raysCtx.save();
        raysCtx.globalCompositeOperation = 'screen';
        raysCtx.beginPath();
        raysCtx.moveTo(sx, sy);
        raysCtx.lineTo(lx, ly);
        raysCtx.lineTo(rx, ry);
        raysCtx.closePath();
        raysCtx.fillStyle = grad;
        raysCtx.fill();
        raysCtx.restore();
      }
    }

    // ── PARTICLES (on main canvas, no filter) ─────────────────────────────
    const particlesCtx = getCtx('aurora-particles');

    interface Particle {
      x: number; y: number; r: number;
      vx: number; vy: number; alpha: number; da: number;
    }

    const PARTICLE_COUNT = 45; // reduced from 60
    const particles: Particle[] = [];

    function buildParticles() {
      particles.length = 0;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: Math.random() * W,
          y: Math.random() * H,
          r: Math.random() * 1.2 + 0.3,
          vx: (Math.random() - 0.5) * 0.15,
          vy: (Math.random() - 0.5) * 0.15,
          alpha: Math.random() * 0.4 + 0.08,
          da: (Math.random() - 0.5) * 0.003,
        });
      }
    }

    function drawParticles() {
      if (!particlesCtx) return;
      particlesCtx.clearRect(0, 0, W, H);
      for (const p of particles) {
        p.x += p.vx; p.y += p.vy;
        p.alpha += p.da;
        if (p.alpha <= 0.05 || p.alpha >= 0.55) p.da = -p.da;
        if (p.x < 0) p.x = W; else if (p.x > W) p.x = 0;
        if (p.y < 0) p.y = H; else if (p.y > H) p.y = 0;
        particlesCtx.beginPath();
        particlesCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        particlesCtx.fillStyle = `rgba(190,160,255,${p.alpha})`;
        particlesCtx.fill();
      }
    }

    // ── MAIN LOOP with visibility pause ───────────────────────────────────
    let animId: number;
    let paused = false;
    let isIntersecting = true;

    function loop() {
      if (!paused && isIntersecting) {
        drawRays();
        drawParticles();
      }
      animId = requestAnimationFrame(loop);
    }

    document.addEventListener('visibilitychange', () => {
      paused = document.hidden;
    });

    // Pause when scrolled out of view to save GPU
    const observer = new IntersectionObserver((entries) => {
      isIntersecting = entries[0].isIntersecting;
    }, { threshold: 0 });
    
    const rootEl = document.querySelector('.aurora-root');
    if (rootEl) observer.observe(rootEl);

    buildRays();
    buildParticles();
    loop();
  })();
</script>
