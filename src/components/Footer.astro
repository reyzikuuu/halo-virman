<style is:global>
.site-footer {
			position: relative;
			width: 100%;
			background: #030305;
			padding: 3.5rem 1.5rem 2rem;
			overflow: hidden;
		}

		.site-footer::before {
			content: "";
			position: absolute;
			top: 0;
			left: 50%;
			transform: translateX(-50%);
			width: 60%;
			height: 1px;
			background: linear-gradient(
				90deg,
				transparent,
				rgba(255, 255, 255, 0.08),
				transparent
			);
		}

		.footer-container {
			max-width: 720px;
			margin: 0 auto;
		}

		.footer-top {
			display: grid;
			grid-template-columns: 2fr 1fr 1fr;
			gap: 2rem;
			margin-bottom: 2rem;
		}

		/* Footer Brand */
		.footer-brand {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
		}

		.footer-logo {
			font-size: 1.4rem;
			font-weight: 800;
			color: white;
			letter-spacing: -0.03em;
		}

		.footer-tagline {
			font-size: 0.85rem;
			line-height: 1.6;
			color: rgba(255, 255, 255, 0.75);
			max-width: 260px;
		}

		/* Footer Nav */
		.footer-nav {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
		}

		.footer-nav-title {
			font-size: 0.7rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: rgba(255, 255, 255, 0.75);
			font-weight: 600;
		}

		.footer-nav-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		.footer-nav-list a {
			font-size: 0.85rem;
			color: rgba(255, 255, 255, 0.75);
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.footer-nav-list a:hover {
			color: #818cf8;
		}

		/* Footer Divider */
		.footer-divider {
			width: 100%;
			height: 1px;
			background: rgba(255, 255, 255, 0.06);
			margin-bottom: 1.5rem;
		}

		/* Footer Bottom */
		.footer-bottom {
			display: flex;
			align-items: center;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.footer-copyright {
			font-size: 0.75rem;
			color: rgba(255, 255, 255, 0.6);
		}

		.footer-credit {
			font-size: 0.75rem;
			color: rgba(255, 255, 255, 0.6);
		}

		.footer-heart {
			font-size: 0.8rem;
		}

		/* Mobile Footer */
		@media (max-width: 768px) {
			.footer-top {
				grid-template-columns: 1fr;
				gap: 1.5rem;
			}

			.footer-bottom {
				flex-direction: column;
				align-items: center;
				text-align: center;
			}
		}
</style>
