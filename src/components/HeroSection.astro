---
import { Image } from "astro:assets";
import mobileHeroImg from "../assets/images/lanyard-hero-mobile.webp";
import desktopHeroImg from "../assets/images/lanyard-hero-desktop.webp";
import capcutIcon from "../assets/icon-tech-stack/capcut-icon.webp";
import metaIcon from "../assets/icon-tech-stack/meta-icon.webp";
import photoshopIcon from "../assets/icon-tech-stack/photoshop-icon.png";
import aeIcon from "../assets/icon-tech-stack/after-effect-icon.png";
import premiereIcon from "../assets/icon-tech-stack/priemere-pro-icon.png";
---
<!-- Hero Section: Two-Column Layout -->
		<div class="hero-container">
			<!-- Mobile Hero Image -->
			<div class="mobile-hero-wrapper">
				<Image
					src={mobileHeroImg}
					alt="Hero Illustration"
					class="mobile-hero-image"
					aria-hidden="true"
					loading="eager"
				/>
			</div>

			<!-- LEFT: Hero Text Content -->
			<div class="hero-left">
				<!-- Status Badge & Modal Trigger -->
				<div class="status-container">
					<div class="status-badge">
						<span class="status-dot"></span>
						<span>Ready for work</span>
					</div>
					<button
						class="info-btn"
						id="openInfoModal"
						aria-label="Lihat Info"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							width="14"
							height="14"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"
							></path><circle cx="12" cy="7" r="4"></circle></svg
						>
						<span>Lihat Info</span>
					</button>
				</div>

				<!-- Main Heading -->
				<h1 class="hero-title">
					<span class="hero-greeting">Halo Dunia, saya</span>
					<span class="hero-name"
						>Virman Adipura<span class="accent-dot">.</span></span
					>
				</h1>

				<!-- Subtitle / Role (Typewriter) -->
				<div class="hero-role" id="hero-role">
					<span class="role-icon" id="role-icon">
						<!-- Video icon (default) -->
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><polygon points="23 7 16 12 23 17 23 7"
							></polygon><rect
								x="1"
								y="5"
								width="15"
								height="14"
								rx="2"
								ry="2"></rect></svg
						>
					</span>
					<span class="role-text" id="role-text"></span>
					<span class="typewriter-cursor">|</span>
				</div>

				<!-- Description -->
				<p class="hero-description">
					halo dunia, suka ngedit dan bikin konten juga sangat
					tertarik dengan hal baru, suka belajar digital marketing,
					web development dan data.
				</p>

				<!-- Tools Icons -->
				<div class="tech-stack">
					<span class="tech-label">software</span>
					<div class="tech-icons">
						<!-- CapCut -->
						<Image
							src={capcutIcon}
							alt="CapCut"
							title="CapCut"
							width="28"
							height="28"
							class="tech-icon"
						/>
						<!-- Meta -->
						<Image
							src={metaIcon}
							alt="Meta"
							title="Meta"
							width="28"
							height="28"
							class="tech-icon"
						/>
						<!-- Photoshop -->
						<Image
							src={photoshopIcon}
							alt="Photoshop"
							title="Photoshop"
							width="28"
							height="28"
							class="tech-icon"
						/>
						<!-- After Effects -->
						<Image
							src={aeIcon}
							alt="After Effects"
							title="After Effects"
							width="28"
							height="28"
							class="tech-icon"
						/>
						<!-- Premiere Pro -->
						<Image
							src={premiereIcon}
							alt="Premiere Pro"
							title="Premiere Pro"
							width="28"
							height="28"
							class="tech-icon"
						/>
					</div>
				</div>

				<!-- CTA Buttons -->
				<div class="hero-cta">
					<a
						href="https://drive.google.com/drive/folders/1NlPrqeOPUAAM106ATVwmqY4fza4C-iF6?usp=sharing"
						target="_blank"
						rel="noopener noreferrer"
						class="btn-primary"
						aria-label="Lihat Portofolio"
					>
						<!-- Portfolio Icon -->
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="7"
								width="20"
								height="14"
								rx="2"
								ry="2"></rect><path
								d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"
							></path></svg
						>
						Lihat Portofolio
					</a>
					<a
						href="https://wa.me/6282119371577"
						target="_blank"
						rel="noopener noreferrer"
						class="btn-whatsapp"
						aria-label="Hubungi Saya via WhatsApp"
					>
						<!-- WhatsApp Icon -->
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="currentColor"
							><path
								d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
							></path></svg
						>
						Hubungi Saya
					</a>
				</div>

				<!-- Social Links -->
				<div class="social-links">
					<a
						href="https://www.instagram.com/virmanadipuraaa_/"
						target="_blank"
						rel="noopener noreferrer"
						class="social-icon"
						title="Instagram"
						aria-label="Instagram Profile"
					>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="20"
							height="20"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							><rect
								x="2"
								y="2"
								width="20"
								height="20"
								rx="5"
								ry="5"></rect><path
								d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
							></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
							></line></svg
						>
					</a>
				</div>
			</div>

			<!-- RIGHT: Hero Image Desktop -->
			<div class="hero-right">
				<Image
					src={desktopHeroImg}
					alt="Hero Illustration Desktop"
					class="desktop-hero-image"
					aria-hidden="true"
					loading="lazy"
				/>
			</div>
		</div>

<style is:global>
/* ===== HERO CONTAINER: Two-Column Layout ===== */
		.hero-container {
			position: absolute;
			inset: 0;
			z-index: 20;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: flex-end;
			padding: 0 1.5rem 4rem;
			min-height: 100vh;
			pointer-events: none;
		}

		@media (min-width: 1024px) {
			.hero-container {
				flex-direction: row;
				align-items: center;
				justify-content: center;
				gap: 2rem;
				padding: 6rem 4rem 0;
				max-width: 1400px;
				margin: 0 auto;
				left: 50%;
				transform: translateX(-50%);
			}
		}

		/* ===== LEFT COLUMN: Hero Text ===== */
		.hero-left {
			display: flex;
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 1rem;
			z-index: 10;
			max-width: 600px;
			pointer-events: none;
		}

		@media (min-width: 1024px) {
			.hero-container {
				pointer-events: auto;
			}
			.hero-left {
				flex: 1;
				align-items: flex-start;
				text-align: left;
				max-width: 560px;
				pointer-events: auto;
			}
		}

		/* ===== STATUS BADGE & INFO ===== */
		.status-container {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			animation: fadeInUp 0.6s ease-out both;
			flex-wrap: wrap;
			pointer-events: auto;
		}

		.status-badge {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.4rem 1rem;
			background: rgba(255, 255, 255, 0.06);
			border: 1px solid rgba(255, 255, 255, 0.1);
			border-radius: 9999px;
			font-size: 0.8rem;
			color: rgba(255, 255, 255, 0.7);
			letter-spacing: 0.02em;
			backdrop-filter: blur(8px);
		}

		.info-btn {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.4rem 0.8rem;
			background: linear-gradient(135deg, #ffffff 0%, #e2e8f0 100%);
			border: 1px solid rgba(255, 255, 255, 0.8);
			border-radius: 9999px;
			font-size: 0.75rem;
			font-weight: 600;
			color: #0f172a;
			cursor: pointer;
			transition: all 0.2s ease;
			box-shadow: 0 4px 10px rgba(255, 255, 255, 0.15);
		}

		.info-btn:hover {
			background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
			color: #000000;
			transform: translateY(-1px);
			box-shadow: 0 6px 15px rgba(255, 255, 255, 0.25);
		}

		.status-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: #34d399;
			box-shadow:
				0 0 8px #34d399,
				0 0 16px rgba(52, 211, 153, 0.3);
			animation: pulse-dot 2s ease-in-out infinite;
		}

		/* ===== HERO TITLE ===== */
		.hero-title {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
			animation: fadeInUp 0.6s ease-out 0.1s both;
		}

		.hero-greeting {
			font-size: 1.2rem;
			font-weight: 400;
			color: rgba(255, 255, 255, 0.75);
			letter-spacing: 0.05em;
		}

		.hero-name {
			font-size: clamp(3rem, 7vw, 5rem);
			font-weight: 800;
			color: white;
			letter-spacing: -0.04em;
			line-height: 1;
		}

		.accent-dot {
			color: #818cf8;
		}

		/* ===== HERO ROLE ===== */
		.hero-role {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			font-size: 1.1rem;
			font-weight: 500;
			color: rgba(255, 255, 255, 0.8);
			animation: fadeInUp 0.6s ease-out 0.2s both;
		}

		.role-icon {
			display: flex;
			align-items: center;
			justify-content: center;
			color: #818cf8;
			transition: opacity 0.3s ease;
		}

		.role-text {
			display: inline-block;
			min-width: 0;
		}

		.typewriter-cursor {
			display: inline-block;
			color: #818cf8;
			font-weight: 300;
			animation: blink 1s step-end infinite;
			margin-left: 1px;
		}

		@keyframes blink {
			0%,
			100% {
				opacity: 1;
			}
			50% {
				opacity: 0;
			}
		}

		/* ===== HERO DESCRIPTION ===== */
		.hero-description {
			font-size: 1rem;
			line-height: 1.7;
			color: rgba(255, 255, 255, 0.75);
			max-width: 440px;
			animation: fadeInUp 0.6s ease-out 0.3s both;
		}

		/* ===== TECH STACK ===== */
		.tech-stack {
			display: flex;
			flex-direction: column;
			gap: 0.6rem;
			animation: fadeInUp 0.6s ease-out 0.4s both;
		}

		.tech-label {
			font-size: 0.7rem;
			text-transform: uppercase;
			letter-spacing: 0.12em;
			color: rgba(255, 255, 255, 0.65);
			font-weight: 600;
		}

		.tech-icons {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			pointer-events: auto;
		}

		.tech-icon {
			object-fit: contain;
			opacity: 0.7;
			transition: all 0.3s ease;
			cursor: default;
		}

		.tech-icon:hover {
			opacity: 1;
			transform: translateY(-2px) scale(1.15);
		}

		/* ===== CTA BUTTONS ===== */
		.hero-cta {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			animation: fadeInUp 0.6s ease-out 0.5s both;
			pointer-events: auto;
		}

		.btn-primary {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.75rem 1.5rem;
			background: rgba(255, 255, 255, 0.03);
			backdrop-filter: blur(10px);
			color: white;
			font-weight: 500;
			font-size: 0.9rem;
			letter-spacing: 0.02em;
			border-radius: 9999px;
			text-decoration: none;
			transition: all 0.3s ease;
			position: relative;
			z-index: 1;
		}

		.btn-primary::before {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: 9999px;
			padding: 1px; /* Thinner, modern border */
			background: linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.1),
				rgba(255, 255, 255, 0.6),
				rgba(129, 140, 248, 0.8),
				rgba(255, 255, 255, 0.1)
			);
			background-size: 200% 100%;
			-webkit-mask:
				linear-gradient(#fff 0 0) content-box,
				linear-gradient(#fff 0 0);
			-webkit-mask-composite: xor;
			mask-composite: exclude;
			z-index: -1;
			animation: shimmerBorder 4s linear infinite;
		}

		.btn-primary:hover {
			background: rgba(255, 255, 255, 0.08);
			transform: translateY(-2px);
			box-shadow: 0 10px 20px -10px rgba(129, 140, 248, 0.4);
		}

		@keyframes shimmerBorder {
			0% {
				background-position: 100% 0;
			}
			100% {
				background-position: -100% 0;
			}
		}

		.btn-whatsapp {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			padding: 0.75rem 1.5rem;
			background: rgba(37, 211, 102, 0.05);
			backdrop-filter: blur(10px);
			color: white;
			font-weight: 500;
			font-size: 0.9rem;
			letter-spacing: 0.02em;
			border-radius: 9999px;
			text-decoration: none;
			transition: all 0.3s ease;
			position: relative;
			z-index: 1;
		}

		.btn-whatsapp::before {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: 9999px;
			padding: 1px;
			background: linear-gradient(
				90deg,
				rgba(255, 255, 255, 0.1),
				rgba(255, 255, 255, 0.6),
				rgba(37, 211, 102, 0.8),
				rgba(255, 255, 255, 0.1)
			);
			background-size: 200% 100%;
			-webkit-mask:
				linear-gradient(#fff 0 0) content-box,
				linear-gradient(#fff 0 0);
			-webkit-mask-composite: xor;
			mask-composite: exclude;
			z-index: -1;
			animation: shimmerBorder 4s linear infinite;
		}

		.btn-whatsapp:hover {
			background: rgba(37, 211, 102, 0.15);
			transform: translateY(-2px);
			box-shadow: 0 10px 20px -10px rgba(37, 211, 102, 0.4);
		}

		/* ===== SOCIAL LINKS ===== */
		.social-links {
			display: flex;
			align-items: center;
			gap: 1.25rem;
			padding-top: 0.5rem;
			animation: fadeInUp 0.6s ease-out 0.6s both;
			pointer-events: auto;
		}

		.social-icon {
			display: flex;
			align-items: center;
			justify-content: center;
			color: rgba(255, 255, 255, 0.65);
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.social-icon:hover {
			color: white;
			transform: translateY(-2px) scale(1.15);
		}

		/* ===== MOBILE HERO IMAGE ===== */
		.mobile-hero-wrapper {
			display: flex !important;
			width: 100%;
			flex: 1;
			align-items: flex-start;
			justify-content: center;
			pointer-events: none;
			margin-top: -2rem; /* Geser sedikit ke atas jika diperlukan */
			animation: slideDownFade 0.7s ease-out both;
		}

		.mobile-hero-image {
			width: 100%;
			max-width: 420px; /* Diperkecil dari 500px */
			max-height: 55vh; /* Diperkecil dari 65vh */
			object-fit: contain;
			object-position: top center;
			margin-left: 7rem; /* ⬅️ Geser Kiri (contoh: -2rem) / Geser Kanan (contoh: 2rem) */
			animation: swingImage 3s ease-in-out infinite alternate;
			transform-origin: top center;
		}

		@keyframes swingImage {
			0% {
				transform: rotate(-7.5deg);
			}
			100% {
				transform: rotate(7.5deg);
			}
		}

		@media (min-width: 1024px) {
			.mobile-hero-wrapper {
				display: none !important;
			}
		}

		/* ===== DESKTOP HERO IMAGE ===== */
		.hero-right {
			display: none;
			flex: 1;
			align-items: center;
			justify-content: center;
			pointer-events: none;
			animation: slideInRight 0.8s ease-out 0.3s both;
		}

		.desktop-hero-image {
			width: 100%;
			max-width: 600px;
			max-height: 100vh;
			object-fit: contain;
			margin-top: -10rem;
			margin-left: 0;
			transform: scale(2);
			transform-origin: center;
			animation: heroFloat 4s ease-in-out infinite;
		}

		@media (min-width: 1024px) {
			.hero-right {
				display: flex;
			}
		}
</style>

<script>
(function () {
			const roles = [
				{
					text: "Video Editor & Layout Designer",
					icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>',
				},
				{
					text: "Junior Meta Advertiser",
					icon: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.2 8.4c.5.38.8.97.8 1.6v4a2 2 0 0 1-1 1.73l-7 4a2 2 0 0 1-2 0l-7-4A2 2 0 0 1 4 14v-4c0-.63.3-1.22.8-1.6l7-5a2 2 0 0 1 2.4 0l7 5Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>',
				},
			];

			const roleText = document.getElementById("role-text");
			const roleIcon = document.getElementById("role-icon");
			if (!roleText || !roleIcon) return;

			let currentRole = 0;
			let charIndex = 0;
			let isDeleting = false;
			const typingSpeed = 65;
			const deletingSpeed = 35;
			const pauseAfterType = 2500;
			const pauseAfterDelete = 400;

			function typeRole() {
				if (!roleText || !roleIcon) return;
				const current = roles[currentRole];

				if (!isDeleting) {
					roleText.textContent = current.text.substring(
						0,
						charIndex + 1,
					);
					charIndex++;

					if (charIndex === current.text.length) {
						setTimeout(() => {
							isDeleting = true;
							typeRole();
						}, pauseAfterType);
						return;
					}
					setTimeout(typeRole, typingSpeed);
				} else {
					roleText.textContent = current.text.substring(
						0,
						charIndex - 1,
					);
					charIndex--;

					if (charIndex === 0) {
						isDeleting = false;
						currentRole = (currentRole + 1) % roles.length;
						roleIcon.innerHTML = roles[currentRole].icon;
						setTimeout(typeRole, pauseAfterDelete);
						return;
					}
					setTimeout(typeRole, deletingSpeed);
				}
			}

			roleIcon.innerHTML = roles[0].icon;
			setTimeout(typeRole, 800);
		})();
</script>
