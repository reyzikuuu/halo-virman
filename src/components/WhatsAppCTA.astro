---
interface Props {
	phoneNumber?: string;
	class?: string;
	text?: string;
	ariaLabel?: string;
}

const {
	phoneNumber = "6288971467723",
	class: customClass = "",
	text = "Hubungi Saya",
	ariaLabel = "Hubungi Saya via WhatsApp",
} = Astro.props;

const testEventCode = import.meta.env.META_TEST_EVENT_CODE || "";
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || "";
const conversionLabel = import.meta.env.PUBLIC_GOOGLE_ADS_CONVERSION_LABEL || "";
const gaId = import.meta.env.PUBLIC_GA_ID || import.meta.env.GOOGLE_ANALYTICS_ID || "";
---

<a
	href={`https://wa.me/${phoneNumber}`}
	target="_blank"
	rel="noopener noreferrer"
	class:list={["btn-whatsapp", customClass]}
	aria-label={ariaLabel}
	data-wa-phone={phoneNumber}
>
	<!-- WhatsApp Icon -->
	<svg
		aria-hidden="true"
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="currentColor"
	>
		<path
			d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
		></path>
	</svg>
	{text}
</a>

<script define:vars={{ testEventCode, googleAdsId, conversionLabel, gaId }}>
	function getCookie(name) {
		const match = document.cookie.match(
			new RegExp("(^| )" + name + "=([^;]+)"),
		);
		return match ? match[2] : undefined;
	}

	function generateRefCode() {
		const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
		let code = "";
		for (let i = 0; i < 4; i++) {
			code += chars.charAt(Math.floor(Math.random() * chars.length));
		}
		return `#REF${code}`;
	}

	function handleWhatsAppClick(e) {
		const target = e.currentTarget.closest("[data-wa-phone]");
		if (!target) return;

		e.preventDefault();

		const phoneNumber =
			target.getAttribute("data-wa-phone") || "6288971467723";
		const refCode = generateRefCode();
		const eventId = `contact_${Date.now()}_${Math.random().toString(36).substring(2, 8)}`;
		const fbc = getCookie("_fbc");
		const fbp = getCookie("_fbp");
		const urlParams = new URLSearchParams(window.location.search);
		let urlGclid = (urlParams.get("gclid") || urlParams.get("GCLID") || "").trim();
		let localGclid = "";
		try {
			localGclid = (localStorage.getItem("_gclid") || "").trim();
		} catch (_) {}
		const cookieGclid = (getCookie("_gclid") || "").trim();

		const gclid = urlGclid || cookieGclid || localGclid || "";

		if (gclid) {
			try {
				localStorage.setItem("_gclid", gclid);
			} catch (_) {}
		}
		const sourceUrl = window.location.href;

		// 1. Memicu Meta Pixel Browser (deduplication via eventID & test_event_code)
		if (typeof window.fbq === "function") {
			const pixelOptions = { eventID: eventId };
			if (testEventCode) {
				pixelOptions.test_event_code = testEventCode;
			}
			window.fbq("track", "Contact", {}, pixelOptions);
		}

		// 1b. Memicu Google Ads & Analytics (gtag) / Google Tag Manager (dataLayer) jika aktif
		if (typeof window.gtag === "function") {
			if (googleAdsId && conversionLabel) {
				window.gtag("event", "conversion", {
					send_to: `${googleAdsId}/${conversionLabel}`,
				});
			}
			if (gaId) {
				window.gtag("event", "generate_lead", {
					event_category: "Engagement",
					event_label: "WhatsApp Contact",
					value: 1,
				});
			}
		}
		if (Array.isArray(window.dataLayer)) {
			window.dataLayer.push({
				event: "whatsapp_click",
				phoneNumber,
				refCode,
				gclid,
			});
		}

		// 2. Mengirim payload ke /api/track-contact (non-blocking serverless CAPI + Google Sheets)
		try {
			fetch("/api/track-contact", {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
				},
				body: JSON.stringify({
					refCode,
					eventId,
					fbc,
					fbp,
					gclid,
					sourceUrl,
				}),
				keepalive: true,
			}).catch(() => {});
		} catch (_) {
			// Fail-safe: jangan halangi proses redirect
		}

		// 3. Redirect ke WhatsApp dengan format pesan voucher / kupon promo
		const message = `Halo Admin, saya mau ambil Promo Diskon via Website. (Mohon jangan hapus Kode Kupon: ${refCode} agar promo berlaku)`;
		const waUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`;

		window.open(waUrl, "_blank", "noopener,noreferrer");
	}

	function setupWhatsAppCTA() {
		document.querySelectorAll("[data-wa-phone]").forEach((btn) => {
			btn.removeEventListener("click", handleWhatsAppClick);
			btn.addEventListener("click", handleWhatsAppClick);
		});
	}

	setupWhatsAppCTA();
	document.addEventListener("astro:page-load", setupWhatsAppCTA);
</script>

<style>
	@keyframes shimmerBorder {
		0% {
			background-position: 100% 0;
		}
		100% {
			background-position: -100% 0;
		}
	}

	.btn-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: rgba(37, 211, 102, 0.05);
		backdrop-filter: blur(10px);
		color: white;
		font-weight: 500;
		font-size: 0.9rem;
		letter-spacing: 0.02em;
		border-radius: 9999px;
		text-decoration: none;
		transition: all 0.3s ease;
		position: relative;
		z-index: 1;
		cursor: pointer;
	}

	.btn-whatsapp::before {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: 9999px;
		padding: 1px;
		background: linear-gradient(
			90deg,
			rgba(255, 255, 255, 0.1),
			rgba(255, 255, 255, 0.6),
			rgba(37, 211, 102, 0.8),
			rgba(255, 255, 255, 0.1)
		);
		background-size: 200% 100%;
		-webkit-mask:
			linear-gradient(#fff 0 0) content-box,
			linear-gradient(#fff 0 0);
		-webkit-mask-composite: xor;
		mask-composite: exclude;
		z-index: -1;
		animation: shimmerBorder 4s linear infinite;
	}

	.btn-whatsapp:hover {
		background: rgba(37, 211, 102, 0.15);
		transform: translateY(-2px);
		box-shadow: 0 10px 20px -10px rgba(37, 211, 102, 0.4);
	}
</style>
